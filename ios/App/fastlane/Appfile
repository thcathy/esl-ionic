team_id        ENV.fetch("APPLE_TEAM_ID", "DU483K8F48")
itc_team_id    ENV["ITC_TEAM_ID"] if ENV["ITC_TEAM_ID"] && !ENV["ITC_TEAM_ID"].empty?

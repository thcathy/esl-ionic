# FunFunSpell iOS Fastlane env
# Copy to ios/App/fastlane/.env (gitignored) and/or fill the repo-root .env
# that ./build.sh already sources:
#   cp ios/App/fastlane/env.example ios/App/fastlane/.env
#
# Do not put real secrets in this file.
# Fastlane also auto-loads ios/App/fastlane/.env. The Fastfile loads repo-root
# .env so APPLE_ID_APP_USERNAME continues to work from there.

# ---- App identity ----
APP_IDENTIFIER=com.esl.ionic
APPLE_ID_APP_USERNAME=
# APPLE_ID=                    # alias for APPLE_ID_APP_USERNAME
# FASTLANE_USER=               # another Apple ID alias Fastlane understands
APPLE_TEAM_ID=DU483K8F48
# ITC_TEAM_ID=                # only if you belong to multiple App Store Connect teams

# App-specific password for Apple ID + 2FA (required unless using an ASC API key)
# FASTLANE_APPLE_APPLICATION_SPECIFIC_PASSWORD=

# ---- App Store Connect API key (optional; avoids Apple ID 2FA prompts) ----
# Create at: App Store Connect → Users and Access → Integrations → App Store Connect API
# Leave these commented to keep the existing Apple ID path.
# All three are required together: key id, issuer id, and key path OR key content.
# Aliases ASC_KEY_ID / ASC_ISSUER_ID / ASC_KEY_PATH / ASC_KEY_CONTENT also work.
# APP_STORE_CONNECT_API_KEY_ID=
# APP_STORE_CONNECT_API_ISSUER_ID=
# APP_STORE_CONNECT_API_KEY_PATH=/absolute/path/to/AuthKey_XXXXXXXX.p8
# Or paste PEM contents (use \n for newlines):
# APP_STORE_CONNECT_API_KEY_CONTENT=-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----

# ---- Signing ----
# FunFunSpell uses Xcode Automatic Signing. Do not set MATCH_GIT_URL here;
# there is no match / sync_certs lane in this repo.

# ---- iOS release behavior (Earn Time–style knobs) ----
# release lane: metadata + binary + submit. After Apple approves, the app goes live
# automatically (no extra App Store Connect click).
SUBMIT_FOR_REVIEW=true
AUTOMATIC_RELEASE=true
PHASED_RELEASE=false
# metadata_ios / release_ios: deliver reads ios/App/fastlane/metadata and screenshots/
# (locale subfolders). 6.9" iPhone shots (1320x2868) map to APP_IPHONE_67 by resolution —
# device-named subfolders are not required.
SKIP_SCREENSHOTS=true
SKIP_METADATA=false
SKIP_WAITING_FOR_BUILD_PROCESSING=true
# SKIP_BUILD=true            # reuse tmp/App.ipa (skip gym; also skip capacitor in build.sh)
# SKIP_BINARY_UPLOAD=true    # submit lane: App Store Connect build only, ignore local IPA
# TESTFLIGHT_CHANGELOG=Bug fixes and improvements

# ---- App Store submission compliance (submit / release when SUBMIT_FOR_REVIEW=true) ----
# Defaults match a standard HTTPS-only app (uses encryption, exempt from ERN).
# ADD_ID_INFO_USES_IDFA=false
# EXPORT_COMPLIANCE_USES_ENCRYPTION=true
# EXPORT_COMPLIANCE_IS_EXEMPT=true
# EXPORT_COMPLIANCE_CONTAINS_THIRD_PARTY_CRYPTOGRAPHY=false
# EXPORT_COMPLIANCE_CONTAINS_PROPRIETARY_CRYPTOGRAPHY=false

# ---- Android / Play (existing ./build.sh release_android) ----
# ESL_IONIC_KEYSTORE_PASSWORD=
# GCLOUD_SERVICE_ACCOUNT_KEY=   # path to Play JSON key (android/fastlane/Appfile)

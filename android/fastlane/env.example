# FunFunSpell Android Fastlane env
# Copy to android/fastlane/.env (gitignored) and/or fill the repo-root .env
# that ./build.sh already sources:
#   cp android/fastlane/env.example android/fastlane/.env
#
# Do not put real secrets in this file.
# Fastlane auto-loads android/fastlane/.env. load_env.rb also loads repo-root
# .env so GCLOUD_SERVICE_ACCOUNT_KEY continues to work from there.

# ---- App identity ----
ANDROID_PACKAGE_NAME=com.esl.ionic

# Play Console service-account JSON key (path). Required for upload lanes.
# Existing FFS name:
# GCLOUD_SERVICE_ACCOUNT_KEY=/absolute/path/to/play-service-account.json
# Earn Time alias (relative paths resolve from the repo root):
# PLAY_STORE_JSON_KEY=android/fastlane/play-store-key.json

# ---- Signing (Gradle, not Fastlane supply) ----
# ESL_IONIC_KEYSTORE_PASSWORD=
# Keystore file: repo-root my-release-key.jks (gitignored), alias esl-dictation

# ---- Tracks / status (Earn Time–style knobs) ----
# beta / validate track: internal | alpha | beta | production
PLAY_TRACK=internal
# Internal/validate status. draft is required until the Play app itself is published once.
PLAY_RELEASE_STATUS=draft
# Production (android release / promote). FunFunSpell defaults to draft (safe).
# Set completed to submit for Google review (Earn Time default after first Console publish).
PLAY_PRODUCTION_STATUS=draft
# Optional staged rollout for production (0.0 - 1.0), e.g. 0.1 = 10%
# PLAY_ROLLOUT=0.1
# false = send the edit for review (needed for auto-submit). Leave unset.
# PLAY_CHANGES_NOT_SENT_FOR_REVIEW=false

# Auto-publish after Google approval is a Play Console setting, not an API flag:
#   Play Console → Publishing overview → turn Managed publishing OFF

# android release (Fastlane) promotes by default (internal → production, no rebuild).
# ./build.sh release_android always uploads a new AAB (PLAY_UPLOAD_AAB=true) as draft.
# PLAY_UPLOAD_AAB=true   # build and upload a new AAB to production instead of promoting
# PLAY_RELEASE_TRACK=production
# PLAY_PROMOTE_FROM=internal
# PLAY_PROMOTE_TO=production
# PLAY_VERSION_CODE=1003001

# Upload toggles
SKIP_UPLOAD_METADATA=true
SKIP_UPLOAD_IMAGES=true
SKIP_UPLOAD_SCREENSHOTS=true
SKIP_UPLOAD_CHANGELOGS=false
# PLAY_VALIDATE_ONLY=true
# SKIP_BUILD=true            # reuse existing AAB; skip capacitor in ./build.sh

# Listing copy (optional; changelogs come from repo-root release_notes/*.txt):
#   android/fastlane/metadata/android/{en-US,zh-TW,zh-CN}/
# Add title.txt / short_description.txt / full_description.txt when you want
# the metadata lane to push store listing text. Images stay skipped by default.
